# Stock-WebAgent（根目錄 FastAPI）環境配置示例
# 本機開發可複製為 .env；Render 請在服務的 Environment 頁面設定。
# 不要提交含真實金鑰的 .env。

# 深度分析、聊天與新聞情緒；快速技術分析可在未設定時運作。
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 登入及資料儲存；SUPABASE_KEY 必須是後端 secret/service-role key，
# 不可把此值放進 static/index.html 或其他瀏覽器程式。
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_backend_supabase_secret_key_here
AUTH_SESSION_SECRET=replace_with_at_least_32_random_characters
ALERT_WEBHOOK_ENCRYPTION_KEY=replace_with_fernet_generate_key_output

TZ=Asia/Taipei

# 選用：啟用 Discord 通知才填寫。
DISCORD_WEBHOOK_URL=

# 大戶增持 × 量能放大監控。先以 dry-run 驗證至少一次，再啟用發送。
# 代號必須包含 .TW 或 .TWO，逗號分隔、去重後最多 20 檔。
HOLDER_ALERT_ENABLED=false
HOLDER_ALERT_DRY_RUN=true
HOLDER_ALERT_TICKERS=2330.TW,6488.TWO

# 當日成交量放大 Discord 通知：每帳號在登入後的「成交量通知設定」輸入股票與 Webhook。
# 需要 Supabase、003 migration、上方兩組密鑰；全域 Discord Webhook 不供個人通知使用。
# 交易日當天收盤資料需達近 15–20 個交易日成交量中位數的指定倍數。
VOLUME_ALERT_ENABLED=false
# 舊全域 VOLUME_ALERT_TICKERS 已不使用；不要在 Render 配置。
VOLUME_ALERT_MULTIPLIER=1.5
